{
  "name": "formsy",
  "private": true,
  "version": "0.0.1",
  "description": "Form backend SaaS — define schema, get endpoint, see submissions.",
  "scripts": {
    "dev": "pnpm --parallel --filter @formsy/backend --filter @formsy/frontend dev",
    "dev:backend": "pnpm --filter @formsy/backend dev",
    "dev:frontend": "pnpm --filter @formsy/frontend dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "db:generate": "pnpm --filter @formsy/backend db:generate",
    "db:migrate": "pnpm --filter @formsy/backend db:migrate",
    "db:studio": "pnpm --filter @formsy/backend db:studio"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.0.0"
}
