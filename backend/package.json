{
  "name": "@formhop/backend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --import tsx/esm --env-file=.env --watch src/index.ts",
    "build": "node build.mjs",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@hono/node-server": "^1.11.1",
    "@hono/zod-validator": "^0.8.0",
    "@upstash/redis": "^1.38.0",
    "better-auth": "^1.7.15",
    "drizzle-orm": "^0.30.10",
    "esbuild": "^0.21.5",
    "hono": "^4.12.23",
    "postgres": "^3.4.9",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "drizzle-kit": "^0.21.4",
    "tsx": "^4.15.4",
    "typescript": "^5.4.5"
  }
}
